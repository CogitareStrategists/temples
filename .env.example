# Neon Postgres (use a Neon dev branch URL for local dev)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/temple_portal?sslmode=require

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Razorpay (platform plan payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Set this to the same secret you configure on the Razorpay webhook (Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Vercel Blob (image uploads) — auto-added when you create a Blob store on Vercel
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# First super admin (used once by scripts/bootstrap-superadmin.ts)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=change_me_now
BOOTSTRAP_SUPERADMIN_NAME=Portal Admin
